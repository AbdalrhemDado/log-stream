{
  "name": "logstream-service",
  "version": "0.1.0",
  "private": true,
  "description": "A structured log ingestion and query service.",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run --passWithNoTests test/integration",
    "test:contract": "vitest run --passWithNoTests test/contract"
  },
  "dependencies": {
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
